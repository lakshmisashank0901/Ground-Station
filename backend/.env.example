# Local (non-Docker) backend settings. Copy to backend/.env. Never commit .env.
# Defaults to SQLite (backend/groundstation.db). For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://groundstation:change-me@localhost:5432/groundstation
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_ENABLED=false
API_KEYS=
SIMULATOR_AUTOSTART=true
AUTO_TRAIN=true
LOG_JSON=true
